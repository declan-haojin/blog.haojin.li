    {
      "objectId": "5dc281d4c05a8000687cb022",
      "url": "/posts/2019-10-24-data-strcture.md/",
      "nick": "Windows10010",
      "link": "https://gobilly.cc",
      "comment": "<p>I think it would be </p>\n<pre><code class=\"language-java\"><span style=\"color: #23AC69\">synchronized</span></code></pre>\n<p>in Java, which is designated to prevent concurrency issues.<br>by the way, it’s called a <strong>keyword</strong> more technically. </p>\n",
      "insertedAt": "2019-11-06T08:18:27.716Z",
      "createdAt": "2019-11-06T08:18:28.587Z",
      "updatedAt": "2023-04-13T04:36:49.118Z",
      "mailMd5": "0cbba5bba589db500ccf5445a3a5560e"
    },
    {
      "objectId": "5ddbae9621460d00711f2a5e",
      "url": "/posts/2019-10-24-data-strcture.md/",
      "nick": "Anonymous",
      "link": "",
      "comment": "<p>~~~ java<br>package examQuestions;</p>\n<p>public class Scramble {<br>    public static String scrambleWord(String word)<br>    {<br>        int len = word.length();<br>        int i   = 0;<br>        while(i&lt;len)<br>        {<br>            String tmp = word.substring(i,i+1);<br>            if(tmp == “A”)<br>            {<br>                if(word.substring(i+2,i+3)!=”A”)<br>                {<br>                    word = word.substring(0,i) + word.substring(i+1,i+2) + word.substring(i,i+1) + word.substring(i+2);<br>                    i = i + 2;<br>                }<br>                else i++;<br>            }<br>            else i++;<br>        }<br>        return word;<br>    }<br>}</p>\n",
      "insertedAt": "2019-11-25T11:01:03.696Z",
      "createdAt": "2019-11-25T10:36:06.449Z",
      "updatedAt": "2023-04-13T04:34:51.703Z",
      "mailMd5": null
    },
    {
      "objectId": "5ddbaece844bb400729fd386",
      "url": "/posts/2019-10-24-data-strcture.md/",
      "nick": "Anonymous",
      "link": "",
      "comment": "<pre><code class=\"language-java\"><span style=\"color: #23AC69\">package</span> <span style=\"color: #91C132\">examQuestions</span>;\n\n<span style=\"color: #F19726\">public</span> <span style=\"color: #E8552D\">class</span> <span style=\"color: #1AAB8E\">Scramble</span> {\n    <span style=\"color: #F19726\">public</span> <span style=\"color: #2980C1\">static</span> <span style=\"color: #1BA1E6\">String</span> <span style=\"color: #9FA0A0\">scrambleWord</span>(<span style=\"color: #1BA1E6\">String</span> <span style=\"color: #E30B20\">word</span>)\n    {\n        <span style=\"color: #E30B20\">int</span> <span style=\"color: #A3338B\">len</span> = <span style=\"color: #E30B20\">word</span>.<span style=\"color: #91C132\">length</span>();\n        <span style=\"color: #E30B20\">int</span> <span style=\"color: #E8552D\">i</span>   = <span style=\"color: #1AAB8E\">0</span>;\n        <span style=\"color: #E1147F\">while</span>(<span style=\"color: #E8552D\">i</span>&lt;<span style=\"color: #A3338B\">len</span>)\n        {\n            <span style=\"color: #1BA1E6\">String</span> <span style=\"color: #F19726\">tmp</span> = <span style=\"color: #E30B20\">word</span>.<span style=\"color: #E30B20\">substring</span>(<span style=\"color: #E8552D\">i</span>,<span style=\"color: #E8552D\">i</span>+<span style=\"color: #91C132\">1</span>);\n            <span style=\"color: #F19726\">if</span>(<span style=\"color: #F19726\">tmp</span> == \"<span style=\"color: #1AAB8E\">A</span>\")\n            {\n                <span style=\"color: #F19726\">if</span>(<span style=\"color: #E30B20\">word</span>.<span style=\"color: #E30B20\">substring</span>(<span style=\"color: #E8552D\">i</span>+<span style=\"color: #F19726\">2</span>,<span style=\"color: #E8552D\">i</span>+<span style=\"color: #E30B20\">3</span>)!=\"<span style=\"color: #1AAB8E\">A</span>\")\n                {    \n                    <span style=\"color: #E30B20\">word</span> = <span style=\"color: #E30B20\">word</span>.<span style=\"color: #E30B20\">substring</span>(<span style=\"color: #1AAB8E\">0</span>,<span style=\"color: #E8552D\">i</span>) + <span style=\"color: #E30B20\">word</span>.<span style=\"color: #E30B20\">substring</span>(<span style=\"color: #E8552D\">i</span>+<span style=\"color: #91C132\">1</span>,<span style=\"color: #E8552D\">i</span>+<span style=\"color: #F19726\">2</span>) + <span style=\"color: #E30B20\">word</span>.<span style=\"color: #E30B20\">substring</span>(<span style=\"color: #E8552D\">i</span>,<span style=\"color: #E8552D\">i</span>+<span style=\"color: #91C132\">1</span>) + <span style=\"color: #E30B20\">word</span>.<span style=\"color: #E30B20\">substring</span>(<span style=\"color: #E8552D\">i</span>+<span style=\"color: #F19726\">2</span>);\n                    <span style=\"color: #E8552D\">i</span> = <span style=\"color: #E8552D\">i</span> + <span style=\"color: #F19726\">2</span>;\n                }\n                <span style=\"color: #E30B20\">else</span> <span style=\"color: #E8552D\">i</span>++;\n            }\n            <span style=\"color: #E30B20\">else</span> <span style=\"color: #E8552D\">i</span>++;\n        }\n        <span style=\"color: #91C132\">return</span> <span style=\"color: #E30B20\">word</span>;\n    }\n}</code></pre>\n",
